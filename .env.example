# Server runtime only. Never use VITE_ for secrets.
# Local Worker: .dev.vars (ignored). Hosted: Sites secrets, then redeploy.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64 of 32 random bytes. Keep stable for stored Google tokens.
TOKEN_ENCRYPTION_KEY=
# VAPID and cron secrets are generated in Supabase Vault.
